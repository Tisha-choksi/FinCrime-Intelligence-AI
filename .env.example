# Copy to .env and fill in real values. Never commit .env.

# --- Postgres (application schema) ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
# Host-side port mapping for docker-compose; change if 5432 is already taken locally.
POSTGRES_HOST_PORT=55432
POSTGRES_DB=fincrime
POSTGRES_APP_USER=app_rw
POSTGRES_APP_PASSWORD=change-me

# --- Postgres (n8n's own schema/user — kept separate from app data) ---
POSTGRES_N8N_USER=n8n_internal
POSTGRES_N8N_PASSWORD=change-me

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379

# --- n8n ---
N8N_HOST=localhost
N8N_PORT=5678
N8N_ENCRYPTION_KEY=change-me
N8N_API_SERVICE_TOKEN=change-me

# --- API control plane ---
API_PORT=8000
API_JWT_AUDIENCE=fincrime-api
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=

# --- AI / LLM provider ---
LLM_PROVIDER=anthropic
LLM_API_KEY=

# --- Object storage (evidence files) ---
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_BUCKET=fincrime-evidence
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=
