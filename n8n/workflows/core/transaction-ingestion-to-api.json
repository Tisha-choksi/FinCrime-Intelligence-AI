    {
      "id": "n2",
      "name": "Generate Correlation Id",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-360, 0],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "function uuidv4() {\n  return 'xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx'.replace(/[xy]/g, (c) => {\n    const r = Math.random() * 16 | 0;\n    const v = c === 'x' ? r : (r & 0x3 | 0x8);\n    return v.toString(16);\n  });\n}\n\n// The webhook node nests the POST payload under `.body`; a caller may\n// supply its own correlationId there to be propagated instead of generated.\nconst out = [];\nfor (const item of $input.all()) {\n  item.json.correlationId = (item.json.body && item.json.body.correlationId) || uuidv4();\n  out.push(item);\n}\nreturn out;"
      }
    },

