      "name": "Ingest Transactions Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [-600, 0],
      "webhookId": "b3e2c9f3-fd4e-4d7a-8f3d-285ea20fc6cc",
